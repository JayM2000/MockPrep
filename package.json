{
  "name": "mock-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:express": "npm --prefix MockPrep_Express run dev",
    "dev:fastapi": "uv run --directory MockPrep_FastAPI fastapi dev",
    "dev:services": "concurrently -n \"express,fastapi\" -c \"blue,green\" \"npm run dev:express\" \"npm run dev:fastapi\"",
    "dev:all": "concurrently -n \"next,express,fastapi\" -c \"magenta,blue,green\" \"npm run dev\" \"npm run dev:express\" \"npm run dev:fastapi\"",
    "db:reset": "npm --prefix MockPrep_Express run db:reset",
    "db:migrate": "npm --prefix MockPrep_Express run migrate:app",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.24",
    "@hookform/resolvers": "^7.0.2",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.23.0",
    "socket.io-client": "^4.8.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
